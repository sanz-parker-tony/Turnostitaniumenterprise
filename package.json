{
  "name": "turnos-titanium-enterprise",
  "version": "0.1.0",
  "private": true,
  "description": "Turnos Titanium Enterprise - Sistema de Gestion de Turnos",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch packages/backend/src/server.ts",
    "start:backend": "node packages/backend/src/server.js",
    "build:backend": "tsc -p packages/backend/tsconfig.json",
    "dev:frontend": "vite --config packages/frontend/vite.config.ts --host 127.0.0.1 --port 3000 --strictPort",
    "build:frontend": "vite build --config packages/frontend/vite.config.ts",
    "preview:frontend": "vite preview --config packages/frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
