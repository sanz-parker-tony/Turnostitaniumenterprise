# Copia este archivo como .env.local y reemplaza los valores.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_de_datos

# Autenticación JWT: son obligatorios y JWT_SECRET debe tener al menos 32 caracteres.
# La duración se obtiene de SECURITY_SESSION_TIMEOUT_MIN en la base de datos.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=turnos-titanium-enterprise
JWT_AUDIENCE=turnos-titanium-enterprise-web

# Opcional
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
